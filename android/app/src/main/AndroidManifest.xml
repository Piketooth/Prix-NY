<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scan des étiquettes de prix -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Deuxième horloge : ville de l'endroit où l'on se trouve -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Page « Applis utiles » : savoir si chaque appli est installée (Android 11+), ouvrir le Play Store -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.citymapper.app.release" />
        <package android:name="info.mta.mymta" />
        <package android:name="com.ubercab" />
        <package android:name="me.lyft.android" />
        <package android:name="com.ridecharge.android.taximagic" />
        <package android:name="com.citibikenyc.citibike" />
        <package android:name="co.bytemark.nycf" />
        <package android:name="com.google.android.apps.translate" />
        <package android:name="com.google.android.apps.walletnfcrel" />
        <package android:name="com.yelp.android" />
        <package android:name="com.opentable" />
        <package android:name="com.todaytix.TodayTix" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- « Ajouter une appli » : liste des applis du téléphone -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
